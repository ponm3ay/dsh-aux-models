{
  "name": "dsh-aux-models",
  "version": "0.1.0",
  "description": "DSH 设置页「辅助模型」面板：按任务选择辅助模型（服务商/模型/超时），选型落盘一份机器可读的槽位表供其它插件与脚本读取。不改 DSH 本体源码。 / A DSH settings page to pick an auxiliary model per task.",
  "license": "MIT",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "verify",
    "build-client.mjs",
    "cordis.patch.yml",
    "entry.js",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "auxiliary-model",
    "model-routing",
    "settings"
  ],
  "author": "ponm3ay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponm3ay/dsh-aux-models.git"
  },
  "homepage": "https://github.com/ponm3ay/dsh-aux-models#readme",
  "bugs": {
    "url": "https://github.com/ponm3ay/dsh-aux-models/issues"
  }
}
